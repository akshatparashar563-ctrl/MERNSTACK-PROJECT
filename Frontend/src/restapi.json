{
  "name": "Restaurant Reservation API",
  "version": "1.0.0",
  "baseUrl": "http://localhost:4000/api/v1",
  "endpoints": [
    {
      "name": "Create Reservation",
      "method": "POST",
      "path": "/reservation",
      "description": "Create a new restaurant reservation",
      "requestBody": {
        "type": "application/json",
        "required": [
          "firstName",
          "lastName",
          "email",
          "phone",
          "reservationDate",
          "reservationTime",
          "partySize"
        ],
        "properties": {
          "firstName": { "type": "string", "example": "John" },
          "lastName": { "type": "string", "example": "Doe" },
          "email": { "type": "string", "example": "john@example.com" },
          "phone": { "type": "string", "example": "+1234567890" },
          "reservationDate": { "type": "string", "format": "YYYY-MM-DD", "example": "2026-10-15" },
          "reservationTime": { "type": "string", "format": "HH:mm", "example": "19:30" },
          "partySize": { "type": "integer", "minimum": 1, "example": 4 },
          "specialRequest": { "type": "string", "example": "Window seat please" }
        }
      },
      "responses": {
        "201": {
          "description": "Reservation created successfully",
          "example": {
            "success": true,
            "message": "Reservation created successfully.",
            "reservation": {
              "firstName": "John",
              "lastName": "Doe",
              "email": "john@example.com",
              "phone": "+1234567890",
              "reservationDate": "2026-10-15T00:00:00.000Z",
              "reservationTime": "19:30",
              "partySize": 4,
              "specialRequest": "Window seat please"
            }
          }
        },
        "400": {
          "description": "Validation error or invalid request data",
          "example": {
            "success": false,
            "message": "Provide firstName and lastName (up to 50 characters each), a valid email, phone, date (YYYY-MM-DD), time (HH:mm), positive party size, and optional special request."
          }
        }
      }
    }
  ]
}
